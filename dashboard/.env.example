# ============================================================
# Cookies Tracker Dashboard — متغيرات البيئة
# انسخ هذا الملف إلى .env وعبّئ القيم
# ============================================================

# --- قاعدة البيانات (نفس قاعدة البوت للحصول على مزامنة حية) ---
# MongoDB Atlas خارجي (mongodb+srv://...) — لا تستخدم MongoDB داخلي من Railway
MONGODB_URI=
# اسم القاعدة نفسه الذي يستخدمه البوت (إن تُرك فارغًا يُستخدم الافتراضي)
MONGODB_DB_NAME=

# --- وضع العرض إن لم تضع MONGODB_URI يعمل الموقع ببيانات تجريبية ---

# --- Discord OAuth2 ---
# من صفحة التطبيق: https://discord.com/developers/applications → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# رابط إعادة التوجيه في صفحة OAuth2 يجب أن يكون:
#   https://<نطاق-موقعك>/api/auth/discord/callback
# معرف السيرفر (تفعيل وضع Developer في ديسكورد ثم كليك يمين على السيرفر)
DISCORD_GUILD_ID=
# معرفات المالكين (يدخلون كل الأقسام) مفصولة بفواصل — اختياري
DISCORD_OWNER_IDS=

# --- توقيع جلسات تسجيل الدخول ---
# أنشئه بأي نص عشوائي طويل: openssl rand -hex 32
SESSION_SECRET=

# --- اختياري: توكن البوت لعرض حالة الاتصال والمزامنة المباشرة ---
DISCORD_BOT_TOKEN=

# --- اختياري: تلميح قاعدة البيانات في شاشة الإعدادات (live / demo) ---
NEXT_PUBLIC_DB_HINT=
